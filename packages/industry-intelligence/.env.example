# Master switch. All capabilities remain inert unless explicitly enabled.
INDUSTRY_INTELLIGENCE_ENABLED=false

# Individual capability gates.
INDUSTRY_RAG_ENABLED=false
INDUSTRY_TOOL_CALLING_ENABLED=false
INDUSTRY_LANGGRAPH_ENABLED=false
INDUSTRY_MCP_ENABLED=false

# Local storage. sqlite is dependency-free; chroma requires the rag extra.
INDUSTRY_VECTOR_BACKEND=sqlite
INDUSTRY_INTELLIGENCE_RUNTIME_DIR=

# Offline deterministic embeddings are intended for tests and smoke runs.
# For semantic production retrieval, set provider=openai and configure a model.
INDUSTRY_EMBEDDING_PROVIDER=hash
INDUSTRY_EMBEDDING_MODEL=
INDUSTRY_OPENAI_MODEL=

# Set OPENAI_API_KEY only in a private local .env or process environment.
OPENAI_API_KEY=
