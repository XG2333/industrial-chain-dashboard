# General
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# Data provider
DATA_PROVIDER=mock_http
MARKET_API_BASE_URL=

# Database
DATABASE_PATH=

# iFinD - leave empty until authorized
IFIND_USERNAME=
IFIND_PASSWORD=

# Gemini - leave empty until AI stage
GEMINI_API_KEY=
GEMINI_MODEL=

# DeepSeek API key（看板"AI 分析"功能需要；留空则 AI 分析返回"LLM API key not configured"）
DEEPSEEK_API_KEY=

# Local repository paths are filled by scripts/configure_env.py.
DASHBOARD_DATA_DIR=
DASHBOARD_CACHE_DIR=
STOCK_TARGETS_DIR=

# Optional workflow publication pointer. Leave empty for local files.
WORKFLOW_CURRENT_PATH=
