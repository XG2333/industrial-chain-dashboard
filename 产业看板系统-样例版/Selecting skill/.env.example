REAL_LLM_ENABLED=false
REAL_LLM_MAX_VARIABLES=20
LLM_RETRY_MIN_SECONDS=1
LLM_RETRY_MAX_SECONDS=30
LLM_RETRY_JITTER_SECONDS=1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
