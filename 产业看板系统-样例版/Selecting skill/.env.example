DATABASE_URL=
DATABASE_ECHO=false
LLM_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_BATCH_SIZE=20
OPENAI_MAX_CONCURRENCY=1

LLM_TEMPERATURE=0
